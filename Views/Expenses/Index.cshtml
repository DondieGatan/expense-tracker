@model IEnumerable<ExpenseTracker.Models.Expense>
@{
    ViewData["Title"] = "Expenses";
    var categories = (string[])ViewBag.Categories;
    var selected = (string?)ViewBag.SelectedCategory;
    var search = (string?)ViewBag.Search;
    var from = (string?)ViewBag.From;
    var to = (string?)ViewBag.To;
}

<div class="page-header">
    <h1 class="page-title">Expenses</h1>
    <div class="actions">
        <a asp-action="Export" asp-route-category="@selected" asp-route-q="@search" asp-route-from="@from" asp-route-to="@to" class="btn btn-ghost">Export CSV</a>
        <a asp-action="Create" class="btn btn-primary">+ Add Expense</a>
    </div>
</div>

<form method="get" class="search-bar">
    <input type="text" name="q" value="@search" placeholder="Search by description…">
    <input type="date" name="from" value="@from" title="From date">
    <input type="date" name="to" value="@to" title="To date">
    <input type="hidden" name="category" value="@selected">
    <button type="submit" class="btn btn-ghost">Search</button>
    @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(from) || !string.IsNullOrEmpty(to))
    {
        <a asp-action="Index" asp-route-category="@selected" class="btn btn-ghost">Clear</a>
    }
</form>

<div class="filters">
    <a asp-action="Index" asp-route-q="@search" asp-route-from="@from" asp-route-to="@to" class="filter-btn @(selected == null ? "active" : "")">All</a>
    @foreach (var c in categories)
    {
        <a asp-action="Index" asp-route-category="@c" asp-route-q="@search" asp-route-from="@from" asp-route-to="@to" class="filter-btn @(selected == c ? "active" : "")">@c</a>
    }
</div>

@if (Model.Any())
{
    <table class="data-table">
        <thead>
            <tr><th>Description</th><th>Category</th><th>Date</th><th>Payment</th><th>Amount</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Description</td>
                    <td><span class="badge">@e.Category</span></td>
                    <td>@e.Date.ToString("yyyy-MM-dd")</td>
                    <td>@e.PaymentMethod</td>
                    <td>@e.Amount.ToString("C")</td>
                    <td class="actions">
                        <a asp-action="Edit" asp-route-id="@e.Id" class="icon-btn">Edit</a>
                        <a asp-action="Delete" asp-route-id="@e.Id" class="icon-btn delete">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    var hasFilters = selected != null || !string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(from) || !string.IsNullOrEmpty(to);
    <div class="empty-state">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        @if (hasFilters)
        {
            <p>No expenses match your filters.</p>
        }
        else
        {
            <p>No expenses logged yet — <a asp-action="Create">add one</a>.</p>
        }
    </div>
}
