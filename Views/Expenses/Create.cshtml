@model ExpenseTracker.Models.Expense
@{
    ViewData["Title"] = "Add Expense";
    var categories = (string[])ViewBag.Categories;
    var paymentMethods = (string[])ViewBag.PaymentMethods;
}

<div class="header-row">
    <a asp-action="Index" class="back-link" aria-label="Back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </a>
    <h1 class="page-title">Add Expense</h1>
</div>

<form asp-action="Create" method="post" class="form-panel">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <label>Description
        <input asp-for="Description" required maxlength="150" placeholder="e.g. Groceries">
        <span asp-validation-for="Description" class="field-validation-error"></span>
    </label>

    <div class="field-row">
        <label>Amount
            <input asp-for="Amount" type="number" step="0.01" min="0.01" required>
            <span asp-validation-for="Amount" class="field-validation-error"></span>
        </label>
        <label>Date
            <input asp-for="Date" type="date" required>
        </label>
    </div>

    <label>Category
        <div class="chip-group" id="categoryChips">
            @foreach (var c in categories)
            {
                <button type="button" class="chip @(Model.Category == c ? "active" : "")" data-value="@c">@c</button>
            }
        </div>
        <input type="hidden" asp-for="Category" />
    </label>

    <label>Payment Method
        <select asp-for="PaymentMethod">
            @foreach (var p in paymentMethods)
            {
                <option value="@p">@p</option>
            }
        </select>
    </label>

    <label>Notes
        <textarea asp-for="Notes" rows="3" placeholder="Optional"></textarea>
    </label>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Add Expense</button>
        <a asp-action="Index" class="btn btn-ghost">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        document.querySelectorAll('#categoryChips .chip').forEach(function (chip) {
            chip.addEventListener('click', function () {
                document.querySelectorAll('#categoryChips .chip').forEach(c => c.classList.remove('active'));
                chip.classList.add('active');
                document.getElementById('Category').value = chip.dataset.value;
            });
        });
    </script>
}
