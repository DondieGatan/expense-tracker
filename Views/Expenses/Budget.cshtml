@model ExpenseTracker.Models.Budget
@{
    ViewData["Title"] = "Set Budget";
}

<div class="header-row">
    <a asp-action="Dashboard" class="back-link" aria-label="Back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </a>
    <h1 class="page-title">Set Monthly Budget</h1>
</div>

<form asp-action="Budget" method="post" class="form-panel">
    <input type="hidden" asp-for="Id">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <label>Monthly Limit
        <input asp-for="MonthlyLimit" type="number" step="0.01" min="0" required placeholder="e.g. 15000">
        <span asp-validation-for="MonthlyLimit" class="field-validation-error"></span>
    </label>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Budget</button>
        <a asp-action="Dashboard" class="btn btn-ghost">Cancel</a>
    </div>
</form>
