@using System.Text.Json
@model ExpenseTracker.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var categoryLabels = JsonSerializer.Serialize(Model.ByCategory.Select(c => c.Category));
    var categoryTotals = JsonSerializer.Serialize(Model.ByCategory.Select(c => c.Total));
    var trendLabels = JsonSerializer.Serialize(Model.MonthlyTrend.Select(m => m.Label));
    var trendTotals = JsonSerializer.Serialize(Model.MonthlyTrend.Select(m => m.Total));
}

<h1 class="page-title">Dashboard</h1>

<div class="balance-card">
    <span class="balance-label">This Month</span>
    <div class="balance-value">@Model.ThisMonthTotal.ToString("C")</div>

    @if (Model.BudgetLimit.HasValue)
    {
        var overBudget = Model.BudgetRemaining < 0;
        <div class="balance-stats">
            <div class="balance-stat">
                <span class="balance-stat-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>
                </span>
                <span>
                    <span class="balance-stat-label">Budget</span>
                    <span class="balance-stat-value">@Model.BudgetLimit.Value.ToString("C")</span>
                </span>
            </div>
            <div class="balance-stat @(overBudget ? "balance-stat-negative" : "")">
                <span class="balance-stat-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @if (overBudget)
                        {
                            <path d="M12 5v14M19 12l-7 7-7-7"/>
                        }
                        else
                        {
                            <path d="M12 19V5M5 12l7-7 7 7"/>
                        }
                    </svg>
                </span>
                <span>
                    <span class="balance-stat-label">@(overBudget ? "Over budget" : "Remaining")</span>
                    <span class="balance-stat-value">@Math.Abs(Model.BudgetRemaining).ToString("C")</span>
                </span>
            </div>
        </div>
    }
    else
    {
        <div class="balance-empty">
            <span>No budget set yet</span>
            <a asp-action="Budget">Set a monthly budget &rarr;</a>
        </div>
    }
</div>

<div class="stat-grid">
    <div class="stat-card">
        <span class="stat-value">@Model.TotalSpent.ToString("C")</span>
        <span class="stat-label">Total Spent (All Time)</span>
    </div>
    <div class="stat-card">
        <span class="stat-value">@Model.ExpenseCount</span>
        <span class="stat-label">Total Expenses</span>
    </div>
</div>

<div class="grid-2">
    <div class="panel">
        <div class="panel-header">
            <h2>Recent Expenses</h2>
            <a asp-action="Index">See all &rarr;</a>
        </div>
        @if (Model.RecentExpenses.Any())
        {
            <div class="txn-list">
                @foreach (var e in Model.RecentExpenses)
                {
                    <div class="txn-row">
                        <span class="txn-icon">@await Html.PartialAsync("_CategoryIcon", e.Category)</span>
                        <span class="txn-main">
                            <span class="txn-title">@e.Description</span>
                            <span class="txn-sub">@e.Category &middot; @e.Date.ToString("MMM d")</span>
                        </span>
                        <span class="txn-amount txn-amount-negative">-@e.Amount.ToString("C")</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                <p>No expenses logged yet — <a asp-action="Create">add one</a>.</p>
            </div>
        }
    </div>

    <div class="panel">
        <h2>By Category</h2>
        @if (Model.ByCategory.Any())
        {
            <div class="chart-wrap chart-wrap-donut"><canvas id="categoryChart"></canvas></div>
        }
        else
        {
            <div class="empty-state">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
                <p>No data yet.</p>
            </div>
        }
    </div>
</div>

<div class="panel">
    <h2>Spending Trend — Last 6 Months</h2>
    <div class="chart-wrap"><canvas id="trendChart"></canvas></div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script>
        const chartTextColor = getComputedStyle(document.body).getPropertyValue('--text-muted').trim();
        const chartGridColor = getComputedStyle(document.body).getPropertyValue('--border').trim();
        const chartAccentColor = getComputedStyle(document.body).getPropertyValue('--accent').trim();
        Chart.defaults.color = chartTextColor;
        Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;

        const categoryLabels = @Html.Raw(categoryLabels);
        const categoryTotals = @Html.Raw(categoryTotals);
        if (categoryLabels.length > 0) {
            new Chart(document.getElementById('categoryChart'), {
                type: 'doughnut',
                data: {
                    labels: categoryLabels,
                    datasets: [{
                        data: categoryTotals,
                        backgroundColor: ['#74f2a0', '#4dd4e0', '#f0b94d', '#f37272', '#9b8cf2', '#5bc9c9', '#e88fc0', '#c9c15b', '#6ba3f2'],
                        borderWidth: 0,
                    }],
                },
                options: {
                    plugins: { legend: { position: 'right', labels: { boxWidth: 12, padding: 14 } } },
                },
            });
        }

        const trendLabels = @Html.Raw(trendLabels);
        const trendTotals = @Html.Raw(trendTotals);
        new Chart(document.getElementById('trendChart'), {
            type: 'bar',
            data: {
                labels: trendLabels,
                datasets: [{
                    label: 'Spent',
                    data: trendTotals,
                    backgroundColor: chartAccentColor,
                    borderRadius: 4,
                    maxBarThickness: 40,
                }],
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: chartGridColor } },
                    x: { grid: { display: false } },
                },
            },
        });
    </script>
}
