@model ExpenseTracker.Models.Expense
@{
    ViewData["Title"] = "Delete Expense";
}

<div class="header-row">
    <a asp-action="Index" class="back-link" aria-label="Back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </a>
    <h1 class="page-title">Delete Expense</h1>
</div>

<div class="panel" style="max-width:560px;">
    <p>Are you sure you want to delete this expense?</p>
    <div class="table-responsive">
        <table class="data-table" style="margin-bottom:18px;">
            <tbody>
                <tr><th>Description</th><td>@Model.Description</td></tr>
                <tr><th>Category</th><td>@Model.Category</td></tr>
                <tr><th>Date</th><td>@Model.Date.ToString("yyyy-MM-dd")</td></tr>
                <tr><th>Amount</th><td>@Model.Amount.ToString("C")</td></tr>
            </tbody>
        </table>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id">
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</div>
