@model RegisterViewModel
@{
    ViewData["Title"] = "Sign Up";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-logo">
        <span class="brand-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg>
        </span>
        <h1>Create your account</h1>
        <p>Start tracking your spending in minutes.</p>
    </div>

    <form asp-controller="Account" asp-action="Register" method="post" novalidate>
        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <div class="auth-field">
            <span class="auth-field-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </span>
            <input asp-for="FullName" type="text" placeholder="Full name" autocomplete="name" />
        </div>

        <div class="auth-field">
            <span class="auth-field-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 6 12 13 2 6"/><path d="M2 6h20v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z"/></svg>
            </span>
            <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="username" />
        </div>

        <div class="auth-field">
            <span class="auth-field-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <input asp-for="Password" type="password" id="passwordInput" placeholder="Password (min. 6 characters)" autocomplete="new-password" />
            <button type="button" class="auth-toggle-visibility" id="togglePassword" aria-label="Show password">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Create Account</button>
    </form>

    <p class="auth-footer">Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a></p>
</div>

@section Scripts {
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const input = document.getElementById('passwordInput');
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            this.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
        });
    </script>
}
