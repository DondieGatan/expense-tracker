@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-logo">
        <span class="brand-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg>
        </span>
        <h1>ExpenseTracker</h1>
        <p>Track every expense, stay in control.</p>
    </div>

    <form asp-controller="Account" asp-action="Login" method="post" novalidate>
        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <div class="auth-field">
            <span class="auth-field-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z" opacity="0"/><path d="M22 6 12 13 2 6"/><path d="M2 6h20v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z"/></svg>
            </span>
            <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="username" />
        </div>

        <div class="auth-field">
            <span class="auth-field-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <input asp-for="Password" type="password" id="passwordInput" placeholder="Password" autocomplete="current-password" />
            <button type="button" class="auth-toggle-visibility" id="togglePassword" aria-label="Show password">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
        </div>

        <div class="auth-links">
            <a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Sign In</button>
    </form>

    <div class="auth-divider">or continue with</div>

    <button type="button" class="social-btn" id="googleBtn" title="Google sign-in isn't configured yet">
        <svg width="16" height="16" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 10.2v3.9h5.5c-.24 1.4-1.7 4.1-5.5 4.1-3.3 0-6-2.7-6-6.2s2.7-6.2 6-6.2c1.9 0 3.1.8 3.9 1.5l2.7-2.6C16.9 3 14.7 2 12 2 6.9 2 2.7 6.1 2.7 12s4.2 10 9.3 10c5.4 0 9-3.8 9-9.1 0-.6-.1-1.1-.1-1.6H12Z"/></svg>
        Continue with Google
    </button>
    <p class="empty-state-inline" id="googleNote" style="display:none; text-align:center; margin-top:8px;">Google sign-in isn't set up yet — use email &amp; password instead.</p>

    <p class="auth-footer">Don't have an account? <a asp-controller="Account" asp-action="Register">Sign up free</a></p>
</div>

@section Scripts {
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const input = document.getElementById('passwordInput');
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            this.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
        });

        document.getElementById('googleBtn').addEventListener('click', function () {
            document.getElementById('googleNote').style.display = 'block';
        });
    </script>
}
