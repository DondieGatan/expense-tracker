@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-logo">
        <span class="brand-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </span>
        <h1>Password reset isn't set up yet</h1>
        <p>This project doesn't have an email service configured, so self-serve password reset isn't available right now. Contact the app owner to reset your password.</p>
    </div>

    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-block">Back to Sign In</a>
</div>
