# Optional: explicitly override the API base URL (e.g. for a deployed backend).
# If unset, the app uses localhost on web and auto-detects your dev machine's
# LAN IP on native/Expo Go.
# EXPO_PUBLIC_API_URL=http://192.168.1.42:5100/api

# IMPORTANT for the Vercel web deploy specifically: eas.json's build.preview/
# production.env only applies to EAS (Android) builds, not the web build that
# Vercel runs itself. Vercel needs its own copy of EXPO_PUBLIC_API_URL set in
# its dashboard (Project Settings > Environment Variables), or the web build
# silently falls back to localhost and login/every API call fails for real
# visitors. (Discovered live on expense-tracker-web-rosy.vercel.app — the var
# was missing there entirely; added it and redeployed to fix.)
